{
  "version": 1,
  "enforce": "always",
  "bash": [
    {
      "id": "git-force-push",
      "decision": "deny",
      "pattern": "\\bgit\\b(?=.*\\spush\\b)(?=.*(?:\\s--force(?:-with-lease)?(?:=\\S*)?(?=\\s|$)|\\s-[a-zA-Z]*f[a-zA-Z]*(?=\\s|$)|\\s\\+\\S))",
      "reason": "Force-pushing is never allowed. Ask the user to do it themselves."
    },
    {
      "id": "db-destructive",
      "decision": "deny",
      "pattern": "\\bartisan\\s+(?:migrate:fresh|migrate:reset|migrate:refresh|db:wipe)\\b|\\bmanage\\.py\\s+(?:flush|reset_db)\\b|\\bdrop\\s+database\\b",
      "unless": "--env[= ]testing\\b|\\bAPP_ENV=testing\\b|\\bDJANGO_SETTINGS_MODULE=\\S*test",
      "flags": "i",
      "reason": "Destructive database commands may only run against the testing environment (add --env=testing)."
    },
    {
      "id": "edit-policy-via-shell",
      "decision": "deny",
      "pattern": "\\.codewright/(?:permissions|profile|app)\\.json",
      "unless": "^\\s*(?:cat|head|tail|less|more|grep|jq|wc)\\b[^>]*$",
      "reason": "Agents may not change the Codewright permission policy or project profile from the shell. Ask the user."
    },
    {
      "id": "write-real-env",
      "decision": "deny",
      "pattern": "(?:>[>|]?|--output\\b|\\btee\\b|\\bsed\\b(?=[^;&|]*\\s-i)|\\bperl\\b(?=[^;&|]*\\s-[a-zA-Z]*i)|\\b(?:cp|mv|rm|truncate|dd|ln)\\b)[^;&|]*?(?<=^|[\\s/'\"=>|:])\\.env(?:\\.(?!example\\b|testing\\b)[\\w.]+)?['\"]?(?=\\s|$)",
      "reason": "The real .env files are off limits. Use .env.testing for the test environment."
    },
    {
      "id": "git-write",
      "decision": "ask",
      "pattern": "\\bgit(?:\\s+-\\S+(?:\\s+(?!-)\\S+)?)*\\s+(?:commit|push|pull|fetch|merge|rebase|reset|checkout|switch|restore|stash|branch|tag|cherry-pick|revert|am|apply|clean|rm|mv|add|init|clone|worktree|submodule|config|update-ref|update-index|gc|prune|notes|filter-branch|filter-repo|commit-tree|replace|bisect|remote|symbolic-ref|sparse-checkout|reflog\\s+(?:expire|delete))\\b",
      "unless": "^\\s*git(?:\\s+-\\S+(?:\\s+(?!-)\\S+)?)*\\s+(?:branch(?:\\s+(?:--show-current|--list|-l|-a|-r|-v|-vv|--all|--remotes|--merged|--no-merged|--contains(?:\\s+\\S+)?))*|stash\\s+(?:list|show)(?:\\s+\\S+)*|tag(?:\\s+(?:-l|--list)(?:\\s+\\S+)*)?|config\\s+(?:--get|--get-all|--list|-l)(?:\\s+\\S+)*|remote(?:\\s+-v)?|remote\\s+(?:show|get-url)(?:\\s+\\S+)*)\\s*$",
      "reason": "This is a git write. Codewright never changes git history without your approval."
    },
    {
      "id": "package-install",
      "decision": "ask",
      "pattern": "\\bcomposer\\s+(?:require|remove|update|upgrade)\\b|\\b(?:npm|pnpm)\\s+(?:install|i|add|uninstall|remove|rm|update|up)\\s+[^-\\s]|\\byarn\\s+(?:add|remove|upgrade)\\b|\\bpip3?\\s+install\\b|\\b(?:flutter|dart)\\s+pub\\s+(?:add|remove|upgrade)\\b|\\bdotnet\\s+add\\b.*\\bpackage\\b|\\bgo\\s+get\\b|\\bcargo\\s+add\\b|\\bmvn\\b.*\\bdependency:",
      "reason": "Adding or changing dependencies needs your approval and must be in the approved plan."
    },
    {
      "id": "migrate-outside-testing",
      "decision": "ask",
      "pattern": "\\bartisan\\s+migrate(?::rollback|:install)?(?=\\s|$)|\\bmanage\\.py\\s+migrate\\b|\\bdotnet\\s+ef\\s+database\\s+update\\b",
      "unless": "--env[= ]testing\\b|\\bAPP_ENV=testing\\b|\\bDJANGO_SETTINGS_MODULE=\\S*test",
      "reason": "Migrations outside the testing environment change your real database."
    },
    {
      "id": "recursive-delete",
      "decision": "ask",
      "pattern": "\\brm\\s+(?:-[a-zA-Z]*r[a-zA-Z]*f[a-zA-Z]*|-[a-zA-Z]*f[a-zA-Z]*r[a-zA-Z]*|-r\\s+-f|-f\\s+-r|--recursive)\\b",
      "reason": "Recursive force-delete needs your approval."
    },
    {
      "id": "git-read",
      "decision": "allow",
      "pattern": "^\\s*git(?:\\s+(?:-C\\s+\\S+|--no-pager))*\\s+(?:status|diff|log|show|blame|ls-files|rev-parse|describe|shortlog|grep|cat-file|ls-tree|merge-base|for-each-ref)(?=\\s|$)(?!.*--output)[^>]*$",
      "reason": "Read-only git."
    },
    {
      "id": "test-and-lint",
      "decision": "allow",
      "pattern": "^\\s*(?:php\\s+artisan\\s+(?:test|route:list|about)|(?:\\./)?vendor/bin/(?:pest|phpunit|phpstan|psalm)|(?:\\./)?vendor/bin/pint\\s+--test|npm\\s+(?:test|run\\s+(?:test|lint|typecheck)(?::[\\w-]+)?)|npx\\s+(?:jest|vitest|eslint|tsc)|flutter\\s+(?:test|analyze)|dart\\s+(?:test|analyze)|dotnet\\s+test|pytest|python3?\\s+-m\\s+pytest|python3?\\s+manage\\.py\\s+test)(?=\\s|$)[^>]*$",
      "reason": "Test, lint and static-analysis commands."
    },
    {
      "id": "jvm-test",
      "decision": "allow",
      "pattern": "^\\s*(?:mvn|(?:\\./)?gradlew?)\\s+(?:clean\\s+)?test\\s*$",
      "reason": "Maven or Gradle test run with no other goals."
    },
    {
      "id": "change-directory",
      "decision": "allow",
      "pattern": "^\\s*cd(?:\\s+[^\\s;&|>]+)?\\s*$",
      "reason": "Changing directory, as in 'cd app && npm test'; the rest of the command is still checked."
    },
    {
      "id": "read-filters",
      "decision": "allow",
      "pattern": "^\\s*(?:head|tail|grep|egrep|wc|uniq|cut)(?=\\s|$)[^>]*$",
      "reason": "Read-only text filters, as used after a pipe."
    }
  ],
  "paths": [
    {
      "id": "edit-policy",
      "decision": "deny",
      "globs": [
        ".codewright/permissions.json"
      ],
      "reason": "Agents may not change the Codewright permission policy. Ask the user to edit it."
    },
    {
      "id": "edit-profile",
      "decision": "ask",
      "globs": [
        ".codewright/profile.json"
      ],
      "reason": "The guard auto-allows the test, lint and analysis commands in profile.json, so changes to it need your approval."
    },
    {
      "id": "edit-app-state",
      "decision": "deny",
      "globs": [
        ".codewright/app.json"
      ],
      "reason": "Only Codewright's app helper may record which process it started."
    },
    {
      "id": "edit-real-env",
      "decision": "deny",
      "globs": [
        "**/.env",
        "**/.env.*"
      ],
      "except": [
        "**/.env.example",
        "**/.env.testing",
        "**/.env.*.example"
      ],
      "reason": "The real .env files are off limits. Use .env.testing for the test environment."
    }
  ],
  "outsideProject": {
    "decision": "deny",
    "except": [
      "~/.claude/**"
    ],
    "reason": "Codewright agents only edit files inside the project."
  }
}
